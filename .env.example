# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cwt
# Apify (https://apify.com) - free tier gives monthly credit
APIFY_TOKEN=
# Default: community actor xtracto/forexfactory-calendar (inputs/outputs read from its Apify docs page).
# NOTE: per its docs, WITHOUT a Residential proxy it falls back to a forecast-only feed (no actuals) and
# this pipeline will refuse to continue. Check your Apify plan allows Residential proxy usage.
APIFY_ACTOR_ID=xtracto/forexfactory-calendar
# {from_date} / {to_date} (YYYY-MM-DD) are substituted at run time. Other actors use different field names.
APIFY_ACTOR_INPUT='{"dateRange":"range","rangeFrom":"{from_date}","rangeTo":"{to_date}","currencies":["USD"],"minImpact":"medium","maxItems":0,"proxyConfiguration":{"useApifyProxy":true,"apifyProxyGroups":["RESIDENTIAL"]}}'

# Tavily (https://tavily.com) - free tier
TAVILY_API_KEY=

# Calendar timestamps with no timezone are assumed to be in this zone (converted to UTC)
CALENDAR_SOURCE_TZ=America/New_York
CALENDAR_COUNTRIES=US,United States,USD
LOOKBACK_DAYS=180
# Extra calendar history fetched only to warm up surprise z-scores (needs >=3 prior prints per event)
WARMUP_DAYS=365

# Trading log
TRADE_LOG_TZ=UTC
# Comma-separated strategy parameter columns present in the trade log CSV
PARAM_COLS=lookback,stop_atr,mode
INITIAL_CAPITAL=100000
PERIODS_PER_YEAR=252
